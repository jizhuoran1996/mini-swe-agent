FROM sbench-build-runtime:v2
USER root
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpsl-dev libidn2-dev libldap2-dev libgmp-dev libmpfr-dev libmpc-dev \
    libnss3-dev libcups2-dev libxtst-dev libxt-dev liblcms2-dev jtreg lz4 less jq rsync locales-all \
    && rm -rf /var/lib/apt/lists/* && dpkg-query -W > /opt/system-packages.txt
