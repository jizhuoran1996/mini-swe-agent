{
  "version": 1,
  "backend": "docker+nvidia",
  "image": "sbench-gpu-runtime:v1",
  "gpu_device": "0",
  "gpu_concurrency": 1,
  "host_memory_gib": 24,
  "swap_gib": 0,
  "cpu_count": 6,
  "pids_limit": 256,
  "workspace_tmpfs_gib": 8,
  "temporary_tmpfs_gib": 1,
  "shared_memory_gib": 1,
  "single_file_max_gib": 2,
  "torch_allocator_fraction": 0.75,
  "gpu_abort_used_mib": 28672,
  "gpu_abort_temperature_c": 87,
  "host_available_memory_floor_gib": 12,
  "host_disk_free_floor_gib": 50,
  "task_wall_timeout_seconds": 1800,
  "command_timeout_seconds": 300,
  "watchdog_interval_seconds": 1,
  "network": "none",
  "root_filesystem": "read_only",
  "privileged": false,
  "capabilities": "drop_all",
  "docker_socket_mounted": false,
  "host_home_mounted": false,
  "input_assets": "read_only",
  "api_credentials_in_container": false,
  "limits_note": "RAM, CPU, pids, tmpfs and file size limits are kernel enforced. PyTorch VRAM fraction and the host watchdog provide headroom; Docker does not supply a kernel-enforced VRAM quota."
}
